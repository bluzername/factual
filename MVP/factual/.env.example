# Environment Variables for Trending Wellness Reels Finder
# Copy this file to .env and fill in your actual API keys

# ═══════════════════════════════════════════════════════════════
# INSTAGRAM GRAPH API CREDENTIALS
# ═══════════════════════════════════════════════════════════════

# Instagram Graph API Access Token
# Get this from: https://developers.facebook.com/tools/explorer/
# Requirements: Business Instagram account connected to Facebook App
IG_ACCESS_TOKEN=your_instagram_access_token_here

# Instagram Business User ID  
# Get this from the Instagram Graph API
# Use this endpoint: /{your-app-id}/accounts
IG_BUSINESS_USER_ID=your_business_user_id_here

# ═══════════════════════════════════════════════════════════════
# OPENAI API CREDENTIALS (RECOMMENDED)
# ═══════════════════════════════════════════════════════════════

# OpenAI API Key for GPT-4 content analysis
# Get this from: https://platform.openai.com/api-keys
# Note: GPT-4 access required for best results
OPENAI_API_KEY=your_openai_api_key_here

# ═══════════════════════════════════════════════════════════════
# EXISTING FACTUAL PIPELINE CREDENTIALS
# ═══════════════════════════════════════════════════════════════

# ElevenLabs API Key (for existing factual pipeline)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ═══════════════════════════════════════════════════════════════
# OPTIONAL CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# Notification webhook URL (optional)
# NOTIFICATION_WEBHOOK=https://hooks.slack.com/services/your/webhook/url

# Custom configuration (optional)
# LOG_LEVEL=INFO
# OUTPUT_DIR=./output
# ARCHIVE_RETENTION_DAYS=30

# ═══════════════════════════════════════════════════════════════
# INSTAGRAM GRAPH API SETUP INSTRUCTIONS
# ═══════════════════════════════════════════════════════════════

# 1. CREATE FACEBOOK APP:
#    - Go to https://developers.facebook.com/
#    - Create a new app
#    - Add Instagram Graph API product
#
# 2. CONNECT INSTAGRAM BUSINESS ACCOUNT:
#    - Ensure you have an Instagram Business account
#    - Connect it to your Facebook Page
#    - Connect the Facebook Page to your app
#
# 3. GET ACCESS TOKEN:
#    - Use Graph API Explorer: https://developers.facebook.com/tools/explorer/
#    - Select your app
#    - Request permissions: instagram_basic, instagram_content_publish
#    - Generate access token
#
# 4. GET BUSINESS USER ID:
#    - Make API call: GET /{your-app-id}/accounts
#    - Find your Instagram account in the response
#    - Use the 'id' field as your BUSINESS_USER_ID

# ═══════════════════════════════════════════════════════════════
# OPENAI API SETUP INSTRUCTIONS  
# ═══════════════════════════════════════════════════════════════

# 1. CREATE OPENAI ACCOUNT:
#    - Sign up at https://platform.openai.com/
#    - Add billing information
#
# 2. GENERATE API KEY:
#    - Go to https://platform.openai.com/api-keys
#    - Create new API key
#    - Copy the key (you won't see it again)
#
# 3. ENSURE GPT-4 ACCESS:
#    - GPT-4 access may require usage history
#    - Check your model availability in the playground
#    - Alternative: Tool will work with reduced functionality without OpenAI

# ═══════════════════════════════════════════════════════════════
# SECURITY NOTES
# ═══════════════════════════════════════════════════════════════

# - Never commit .env file to version control
# - Rotate access tokens regularly (Instagram tokens expire after 60 days)
# - Use environment variables in production
# - Store credentials securely (consider using a secrets manager)
# - Limit API key permissions to minimum required scope