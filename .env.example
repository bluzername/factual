# Copy to .env, fill in real values. Never commit .env.
# The run_factual*.sh wrappers export this file; for factual_cli.py run
# `set -a; source .env; set +a` first (or export the variables yourself).

# Required
OPENAI_API_KEY=your_openai_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional model overrides (defaults shown; see MVP/factual/model_config.py)
FACTUAL_LLM_MODEL=gpt-5-nano
FACTUAL_LLM_MINI_MODEL=gpt-5-nano
FACTUAL_WHISPER_MODEL=whisper-1
FACTUAL_TTS_MODEL=eleven_flash_v2
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Only for MVP/factual/get_trending_reels_insights.py (Instagram Graph API)
IG_ACCESS_TOKEN=
IG_BUSINESS_USER_ID=
